# Local-only credentials. Replace every value before using the stack outside a developer laptop.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin-local-change-me
KEYCLOAK_DB_PASSWORD=local-keycloak-db-change-me
BRIDGE_COOKIE_KEYS=local-cookie-key-change-me
KEYCLOAK_BROKER_CLIENT_SECRET=local-bridge-secret-change-me
OPENPROJECT_OIDC_CLIENT_SECRET=local-openproject-oidc-secret-change-me
COLLABORATIVE_SERVER_SECRET=local-collaboration-secret-change-me

# Public URLs are reconciled into Keycloak and OpenProject. Gateway host values omit ports.
BRIDGE_ISSUER=http://bridge.localhost:8090
BRIDGE_PUBLIC_HOST=bridge.localhost
KEYCLOAK_PUBLIC_URL=http://keycloak.localhost:8090
KEYCLOAK_PUBLIC_HOST=keycloak.localhost
KEYCLOAK_BROKER_REDIRECT_URI=http://keycloak.localhost:8090/realms/amperun/broker/wecom/endpoint
OPENPROJECT_PUBLIC_URL=http://openproject.localhost:8090
OPENPROJECT_PUBLIC_HOST=openproject.localhost:8090
OPENPROJECT_GATEWAY_HOST=openproject.localhost
OPENPROJECT_ADMIN_HOST=openproject-admin.localhost:8090
OPENPROJECT_ADMIN_GATEWAY_HOST=openproject-admin.localhost
OPENPROJECT_COLLABORATION_PUBLIC_URL=ws://openproject.localhost:8090/hocuspocus

# mock: local users; wecom: real enterprise application.
WECOM_MODE=mock
WECOM_AUTH_STYLE=qr
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_APP_SECRET=
WECOM_ALLOWED_USER_IDS=

OPENPROJECT_DB_PASSWORD=local-openproject-db-change-me
OPENPROJECT_SECRET_KEY_BASE=local-openproject-secret-key-base-change-me-32chars
OPENPROJECT_ADMIN_PASSWORD=admin
