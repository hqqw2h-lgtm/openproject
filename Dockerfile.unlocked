# Custom OpenProject image with Enterprise feature gates unlocked (GPLv3 fork).
# See FORK_NOTICE.md for modification notice and license obligations.
#
# Base matches the Community slim image used by openproject-docker-compose.
ARG BASE_IMAGE=openproject/openproject:17-slim
FROM ${BASE_IMAGE}

LABEL org.opencontainers.image.source="https://github.com/hqqw2h-lgtm/openproject"
LABEL org.opencontainers.image.description="OpenProject Community slim with Enterprise add-ons unlocked (GPLv3 fork)"
LABEL org.opencontainers.image.licenses="GPL-3.0-only"

# Override feature-gate helpers and hide EE upsell banners by default.
COPY app/models/enterprise_token.rb /app/app/models/enterprise_token.rb
COPY config/constants/settings/definition.rb /app/config/constants/settings/definition.rb
COPY FORK_NOTICE.md /app/FORK_NOTICE.md

ENV OPENPROJECT_EE__HIDE__BANNERS=true
